# Production Environment Variables
# Copy to .env.production and fill in actual values

# ============================================
# APPLICATION
# ============================================
NODE_ENV=production
APP_NAME=Online Consultancy Platform
APP_URL=https://consultancy.com
API_URL=https://api.consultancy.com

# ============================================
# DATABASE - POSTGRESQL
# ============================================
DATABASE_URL=postgresql://consultancy:CHANGE_ME@postgres-primary:5432/consultancy
DATABASE_HOST=postgres-primary
DATABASE_PORT=5432
DATABASE_NAME=consultancy
DATABASE_USER=consultancy
DATABASE_PASSWORD=CHANGE_ME_IN_PRODUCTION
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_SSL=true

# ============================================
# DATABASE - MONGODB
# ============================================
MONGODB_URI=mongodb://consultancy:CHANGE_ME@mongodb:27017/consultancy
MONGODB_USER=consultancy
MONGODB_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ============================================
# DATABASE - REDIS
# ============================================
REDIS_URL=redis://redis-primary:6379
REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION
REDIS_CLUSTER=false

# ============================================
# DATABASE - ELASTICSEARCH
# ============================================
ELASTICSEARCH_URL=https://elasticsearch:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ============================================
# DATABASE - NEO4J
# ============================================
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ============================================
# DATABASE - PINECONE
# ============================================
PINECONE_API_KEY=CHANGE_ME_IN_PRODUCTION
PINECONE_ENVIRONMENT=production
PINECONE_INDEX_NAME=consultancy-memory

# ============================================
# DATABASE - TIMESCALEDB
# ============================================
TIMESCALEDB_URL=postgresql://analytics:CHANGE_ME@timescaledb:5432/analytics
TIMESCALEDB_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ============================================
# MESSAGE QUEUE - KAFKA
# ============================================
KAFKA_BROKERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
KAFKA_CLIENT_ID=consultancy-prod
KAFKA_GROUP_ID=consultancy-consumers
KAFKA_USERNAME=consultancy
KAFKA_PASSWORD=CHANGE_ME_IN_PRODUCTION
KAFKA_TOPIC_PREFIX=consultancy-prod

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_ME_TO_DIFFERENT_LONG_RANDOM_STRING
AUTH_COOKIE_NAME=auth_token
AUTH_COOKIE_EXPIRY=7

# ============================================
# PAYMENTS - STRIPE
# ============================================
STRIPE_API_KEY=sk_live_CHANGE_ME_IN_PRODUCTION
STRIPE_SECRET_KEY=sk_live_CHANGE_ME_IN_PRODUCTION
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME_IN_PRODUCTION
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME_IN_PRODUCTION

# ============================================
# PAYMENTS - PAYPAL
# ============================================
PAYPAL_CLIENT_ID=CHANGE_ME_IN_PRODUCTION
PAYPAL_CLIENT_SECRET=CHANGE_ME_IN_PRODUCTION
PAYPAL_ENVIRONMENT=live
PAYPAL_WEBHOOK_ID=CHANGE_ME_IN_PRODUCTION

# ============================================
# COMMUNICATION - SENDGRID
# ============================================
SENDGRID_API_KEY=SG.CHANGE_ME_IN_PRODUCTION
SENDGRID_FROM_EMAIL=noreply@consultancy.com
SENDGRID_FROM_NAME=Consultancy Platform

# ============================================
# COMMUNICATION - TWILIO
# ============================================
TWILIO_ACCOUNT_SID=AC_CHANGE_ME_IN_PRODUCTION
TWILIO_AUTH_TOKEN=CHANGE_ME_IN_PRODUCTION
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_SMS_WEBHOOK_URL=https://api.consultancy.com/webhooks/twilio

# ============================================
# COMMUNICATION - WhatsApp Business
# ============================================
WHATSAPP_BUSINESS_TOKEN=CHANGE_ME_IN_PRODUCTION
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME_IN_PRODUCTION
WHATSAPP_VERIFY_TOKEN=consultancy_webhook_verify_token
WHATSAPP_BUSINESS_ACCOUNT_ID=CHANGE_ME_IN_PRODUCTION

# ============================================
# COMMUNICATION - Firebase Push
# ============================================
FIREBASE_PROJECT_ID=consultancy-platform
FIREBASE_API_KEY=CHANGE_ME_IN_PRODUCTION
FIREBASE_AUTH_DOMAIN=consultancy-platform.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=CHANGE_ME_IN_PRODUCTION
FIREBASE_APP_ID=CHANGE_ME_IN_PRODUCTION

# ============================================
# AI - Anthropic Claude
# ============================================
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME_IN_PRODUCTION
ANTHROPIC_MODEL=claude-3-opus-20240229

# ============================================
# AI - OpenAI
# ============================================
OPENAI_API_KEY=sk-CHANGE_ME_IN_PRODUCTION
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# AI - Cohere
# ============================================
COHERE_API_KEY=CHANGE_ME_IN_PRODUCTION

# ============================================
# AI - DeepL Translation
# ============================================
DEEPL_API_KEY=CHANGE_ME_IN_PRODUCTION
DEEPL_PRO=true

# ============================================
# AI - ElevenLabs TTS
# ============================================
ELEVENLABS_API_KEY=CHANGE_ME_IN_PRODUCTION

# ============================================
# VIDEO - WebRTC TURN Servers
# ============================================
TURN_SERVER_URL=turn:turn.consultancy.com:443
TURN_SERVER_USERNAME=CHANGE_ME_IN_PRODUCTION
TURN_SERVER_PASSWORD=CHANGE_ME_IN_PRODUCTION
WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# ============================================
# VIDEO - TokBox/Vonage (Optional)
# ============================================
VONAGE_API_KEY=CHANGE_ME_IN_PRODUCTION
VONAGE_API_SECRET=CHANGE_ME_IN_PRODUCTION

# ============================================
# STORAGE - AWS S3
# ============================================
S3_BUCKET=consultancy-content-prod
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME_IN_PRODUCTION
S3_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
S3_CDN_URL=https://cdn.consultancy.com

# ============================================
# STORAGE - Cloudflare R2 (Alternative)
# ============================================
R2_BUCKET=consultancy-content
R2_ACCESS_KEY=CHANGE_ME_IN_PRODUCTION
R2_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
R2_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com

# ============================================
# MONITORING - DataDog
# ============================================
DATADOG_API_KEY=CHANGE_ME_IN_PRODUCTION
DATADOG_APP_KEY=CHANGE_ME_IN_PRODUCTION
DATADOG_ENV=production
DATADOG_SERVICE=consultancy-platform

# ============================================
# MONITORING - Sentry
# ============================================
SENTRY_DSN=https://CHANGE_ME@sentry.io/PROJECT_ID
SENTRY_ENVIRONMENT=production

# ============================================
# MONITORING - Grafana
# ============================================
GRAFANA_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ============================================
# CDN & WAF - Cloudflare
# ============================================
CLOUDFLARE_ZONE_ID=CHANGE_ME_IN_PRODUCTION
CLOUDFLARE_API_TOKEN=CHANGE_ME_IN_PRODUCTION

# ============================================
# KUBERNETES
# ============================================
K8S_NAMESPACE=consultancy
K8S_CLUSTER_NAME=consultancy-production
KUBE_CONFIG=CHANGE_ME_IN_PRODUCTION

# ============================================
# DOMAIN & SSL
# ============================================
DOMAIN=consultancy.com
SSL_CERTIFICATE_ARN=CHANGE_ME_IN_PRODUCTION

# ============================================
# MULTI-REGION
# ============================================
DEFAULT_REGION=US
DEFAULT_CURRENCY=USD
DEFAULT_LANGUAGE=en
SUPPORTED_REGIONS=US,UK,EU,IN,SG,AU
SUPPORTED_CURRENCIES=USD,GBP,EUR,INR,SGD,AUD
SUPPORTED_LANGUAGES=en,es,fr,de,hi,zh

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=10

# ============================================
# PLATFORM SETTINGS
# ============================================
PLATFORM_FEE_PERCENTAGE=15
MIN_BOOKING_AMOUNT=10
MAX_BOOKING_DURATION=480
DEFAULT_SESSION_DURATION=60
BOOKING_REMINDER_HOURS=24
AUTO_APPROVE_CONSULTANTS=false
REQUIRE_CONSULTANT_VERIFICATION=true
ENABLE_VIDEO_SESSIONS=true
ENABLE_WHATSAPP_BOT=true
ENABLE_AI_CHATBOT=true
ENABLE_AI_MATCHING=true

# ============================================
# SUPPORT
# ============================================
SUPPORT_EMAIL=support@consultancy.com
SUPPORT_PHONE=+1-800-CONSULT
SUPPORT_CHAT_URL=https://support.consultancy.com

# ============================================
# ADMIN
# ============================================
ADMIN_API_KEY=CHANGE_ME_IN_PRODUCTION
ADMIN_DASHBOARD_URL=https://admin.consultancy.com

# ============================================
# WEBHOOKS
# ============================================
WEBHOOK_SECRET=CHANGE_ME_IN_PRODUCTION

# ============================================
# SOCIAL LOGIN
# ============================================
GOOGLE_CLIENT_ID=CHANGE_ME_IN_PRODUCTION.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME_IN_PRODUCTION
FACEBOOK_APP_ID=CHANGE_ME_IN_PRODUCTION
FACEBOOK_APP_SECRET=CHANGE_ME_IN_PRODUCTION
LINKEDIN_CLIENT_ID=CHANGE_ME_IN_PRODUCTION
LINKEDIN_CLIENT_SECRET=CHANGE_ME_IN_PRODUCTION

# ============================================
# APPLE SIGN IN
# ============================================
APPLE_CLIENT_ID=CHANGE_ME_IN_PRODUCTION
APPLE_CLIENT_SECRET=CHANGE_ME_IN_PRODUCTION
APPLE_TEAM_ID=CHANGE_ME_IN_PRODUCTION
APPLE_KEY_ID=CHANGE_ME_IN_PRODUCTION