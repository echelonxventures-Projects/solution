{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@stores": ["src/stores"],
      "@stores/*": ["src/stores/*"],
      "@contexts": ["src/contexts"],
      "@contexts/*": ["src/contexts/*"],
      "@lib": ["src/lib"],
      "@lib/*": ["src/lib/*"],
      "@screens": ["src/screens"],
      "@screens/*": ["src/screens/*"],
      "@components": ["src/components"],
      "@components/*": ["src/components/*"]
    },
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-native"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}