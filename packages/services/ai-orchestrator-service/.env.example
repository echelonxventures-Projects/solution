# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=3007

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/consultancy_ai

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_PREFIX=consultancy

# AI Providers
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
OPENAI_API_KEY=${OPENAI_API_KEY}

# Redis for caching
REDIS_URL=localhost:6379

# Matching Settings
MATCHING_MIN_SCORE=0.6
MATCHING_MAX_RESULTS=20
MATCHING_USE_AI=true

# Chatbot Settings
CHATBOT_MODEL=claude-3-opus
CHATBOT_MAX_TOKENS=4096
CHATBOT_TEMPERATURE=0.7

# Translation Settings
TRANSLATION_PROVIDER=deep
TRANSLATION_ENABLED=true

# Sentiment Analysis
SENTIMENT_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json