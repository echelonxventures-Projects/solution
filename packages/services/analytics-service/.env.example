# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=3011

# Database (TimescaleDB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/consultancy_analytics

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_PREFIX=consultancy

# Redis for caching
REDIS_URL=localhost:6379
REDIS_DB=1

# Analytics Settings
ANALYTICS_RETENTION_DAYS=365
ANALYTICS_AGGREGATION_INTERVAL_MINUTES=5
ANALYTICS_PREDICTION_ENABLED=true

# Dashboard Settings
DASHBOARD_REFRESH_INTERVAL_SECONDS=30
DASHBOARD_MAX_DATA_POINTS=1000

# Report Settings
REPORT_STORAGE_PATH=/var/consultancy/reports
REPORT_FORMATS=pdf,csv,json

# Prediction Models
PREDICTION_FORECAST_DAYS=30
PREDICTION_MIN_DATA_POINTS=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json