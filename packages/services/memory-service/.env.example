# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=3008

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/consultancy_memory

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_PREFIX=consultancy

# Redis (Working Memory)
REDIS_URL=localhost:6379
REDIS_DB=0

# Pinecone (Vector Storage)
PINECONE_API_KEY=${PINECONE_API_KEY}
PINECONE_ENVIRONMENT=${PINECONE_ENVIRONMENT}
PINECONE_INDEX_NAME=consultancy-memory

# Neo4j (Knowledge Graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# MongoDB (Document Storage)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=consultancy_memory

# Embeddings
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIMENSION=1536

# Memory Settings
MEMORY_RETENTION_DAYS=365
MEMORY_CONSOLIDATION_INTERVAL_HOURS=24
MEMORY_MAX_WORKING_SIZE_MB=100
MEMORY_SIMILARITY_THRESHOLD=0.85

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json