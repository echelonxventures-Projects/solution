# Environment Configuration Template
# Copy to .env and fill in values

# ===== APPLICATION =====
NODE_ENV=development
APP_NAME=consultancy-platform
API_VERSION=v1
LOG_LEVEL=debug

# ===== DATABASE =====
# PostgreSQL (Primary)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/consultancy
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=consultancy
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ===== AUTHENTICATION =====
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret

# ===== EVENT BUS (Kafka) =====
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=consultancy-platform
KAFKA_GROUP_ID=consultancy-group

# ===== AI SERVICES =====
# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-3-opus-20240229

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ===== COMMUNICATION =====
# WebRTC
WEBRTC_SERVER_REGION=us-west
WEBRTC_SECRET_KEY=webrtc-secret

# SendGrid (Email)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@consultancy-platform.com

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# WhatsApp Business
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_BUSINESS_TOKEN=your-whatsapp-access-token
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# ===== PAYMENT =====
# Stripe (Go billing-service reads STRIPE_API_KEY)
STRIPE_API_KEY=your-stripe-secret-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# ===== STORAGE =====
# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-west-2
AWS_S3_BUCKET_RECORDINGS=consultancy-recordings
AWS_S3_BUCKET_CONTENT=consultancy-content
AWS_S3_BUCKET_ATTACHMENTS=consultancy-attachments

# ===== SEARCH =====
# ElasticSearch (future)
ELASTICSEARCH_HOST=localhost:9200

# Pinecone (Vector DB - future)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment
PINECONE_INDEX_NAME=consultancy-knowledge

# ===== MONITORING =====
# Prometheus
PROMETHEUS_GATEWAY=localhost:9091

# DataDog (optional)
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key

# ===== REDIS (future) =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== MongoDB (future) =====
MONGODB_URI=mongodb://localhost:27017/consultancy

# ===== SERVICE PORTS =====
USER_SERVICE_PORT=3001
CONSULTANT_SERVICE_PORT=3002
BOOKING_SERVICE_PORT=3003
COMMUNICATION_SERVICE_PORT=3004
BILLING_SERVICE_PORT=3005
CONTENT_SERVICE_PORT=3006
AI_ORCHESTRATOR_PORT=3007
MEMORY_SERVICE_PORT=3008
SEARCH_SERVICE_PORT=3009
NOTIFICATION_SERVICE_PORT=3010
ANALYTICS_SERVICE_PORT=3011
COMPLIANCE_SERVICE_PORT=3012
INTEGRATION_SERVICE_PORT=3013
VERTICAL_SERVICE_PORT=3014
API_GATEWAY_PORT=3000

# ===== FRONTEND =====
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000