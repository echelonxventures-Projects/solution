# Development Environment Variables
# Copy to .env.development and use for local development

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
APP_NAME=Online Consultancy Platform
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# ============================================
# DATABASE - POSTGRESQL
# ============================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=consultancy
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ============================================
# DATABASE - MONGODB (Optional for development)
# ============================================
MONGODB_URI=mongodb://localhost:27017/consultancy
MONGODB_USER=
MONGODB_PASSWORD=

# ============================================
# DATABASE - REDIS
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_CLUSTER=false

# ============================================
# DATABASE - ELASTICSEARCH (Optional)
# ============================================
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=

# ============================================
# MESSAGE QUEUE - KAFKA
# ============================================
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=consultancy-dev
KAFKA_GROUP_ID=consultancy-dev-consumers
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_TOPIC_PREFIX=consultancy-dev

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET=dev_jwt_secret_do_not_use_in_production_minimum_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_SECRET=dev_refresh_secret_do_not_use_in_production
AUTH_COOKIE_NAME=auth_token
AUTH_COOKIE_EXPIRY=7

# ============================================
# PAYMENTS - STRIPE (Test Mode)
# ============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================
# PAYMENTS - PAYPAL (Sandbox)
# ============================================
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_secret
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# ============================================
# COMMUNICATION - SENDGRID (Optional)
# ============================================
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@localhost
SENDGRID_FROM_NAME=Consultancy Dev

# ============================================
# COMMUNICATION - TWILIO (Optional)
# ============================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================
# COMMUNICATION - WhatsApp Business (Optional)
# ============================================
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=dev_verify_token

# ============================================
# AI - Anthropic Claude (Optional for basic dev)
# ============================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229

# ============================================
# AI - OpenAI (Optional)
# ============================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# STORAGE - AWS S3 (Optional - use local for dev)
# ============================================
S3_BUCKET=consultancy-content-dev
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_CDN_URL=

# ============================================
# VIDEO - WebRTC
# ============================================
WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# ============================================
# MONITORING (Optional)
# ============================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ============================================
# SERVICE PORTS
# ============================================
USER_SERVICE_PORT=3001
CONSULTANT_SERVICE_PORT=3002
BOOKING_SERVICE_PORT=3003
COMMUNICATION_SERVICE_PORT=3004
BILLING_SERVICE_PORT=3005
CONTENT_SERVICE_PORT=3006
AI_ORCHESTRATOR_PORT=3007
MEMORY_SERVICE_PORT=3008
SEARCH_SERVICE_PORT=3009
NOTIFICATION_SERVICE_PORT=3010
ANALYTICS_SERVICE_PORT=3011
COMPLIANCE_SERVICE_PORT=3012
INTEGRATION_SERVICE_PORT=3013
VERTICAL_SERVICE_PORT=3014
WHATSAPP_BOT_PORT=3015

# ============================================
# PLATFORM SETTINGS
# ============================================
PLATFORM_FEE_PERCENTAGE=15
MIN_BOOKING_AMOUNT=10
MAX_BOOKING_DURATION=480
DEFAULT_SESSION_DURATION=60
BOOKING_REMINDER_HOURS=24
AUTO_APPROVE_CONSULTANTS=true
REQUIRE_CONSULTANT_VERIFICATION=false
ENABLE_VIDEO_SESSIONS=true
ENABLE_WHATSAPP_BOT=false
ENABLE_AI_CHATBOT=false
ENABLE_AI_MATCHING=false

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=10

# ============================================
# ADMIN
# ============================================
ADMIN_API_KEY=dev_admin_key
ADMIN_DASHBOARD_URL=http://localhost:3000/admin

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_FORMAT=pretty