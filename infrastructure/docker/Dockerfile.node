# ===== Node.js Service Dockerfile =====
# Use for: user-service, consultant-service, booking-service,
#          notification-service, content-service, compliance-service,
#          integration-service, vertical-service

FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies
COPY package*.json ./
COPY tsconfig.json ./
RUN npm ci

# Copy source
COPY src/ ./src/

# Build
RUN npm run build

# Production stage
FROM node:20-alpine AS production

WORKDIR /app

# Copy built files
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

# Set environment
ENV NODE_ENV=production

# Expose port (should be set via environment)
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:${PORT:-3000}/health || exit 1

# Run
CMD ["node", "dist/index.js"]

# ===== Development Dockerfile =====
# Use this for local development with hot reload

FROM node:20-alpine AS development

WORKDIR /app

# Install dependencies for development
COPY package*.json ./
RUN npm install

# Copy everything
COPY . .

# Set environment
ENV NODE_ENV=development

# Expose port
EXPOSE 3000

# Run with hot reload
CMD ["npm", "run", "dev"]